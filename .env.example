POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Kunci penandatanganan sesi Auth.js. Wajib diisi nilai acak, contoh cara buat:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Hanya dipakai sekali oleh scripts/buat-akun.ts (npm run buat-akun) untuk
# membuat/reset akun. Bukan dibaca aplikasi saat login — lihat CLAUDE.md aturan #6.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Sinkronisasi satu arah gl_mirror -> Google Sheets (lib/google-sheets/).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SHEET_ID=

# URL publik SIGAP (tanpa slash di akhir), mis. https://sigap.contoh.id.
# Dipakai membangun tautan Laporan Survei TKP/KSKK di kolom Google Sheets.
APP_URL=
