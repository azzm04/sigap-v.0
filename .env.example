POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Kunci penandatanganan sesi Auth.js. Wajib diisi nilai acak, contoh cara buat:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Hanya dipakai sekali oleh scripts/buat-akun.ts (npm run buat-akun) untuk
# membuat/reset akun. Bukan dibaca aplikasi saat login — lihat CLAUDE.md aturan #6.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP untuk email pengingat impor (Tahap 2). Isi dengan kredensial layanan
# email apa pun yang tersedia (Gmail, hosting, SMTP relay). Kalau kosong,
# pengingat gagal terkirim dengan galat yang jelas di log server.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Opsional, default ke SMTP_USER kalau kosong.
SMTP_FROM=

# Token rahasia yang harus disertakan cron sistem saat memanggil
# /api/cron/pengingat-impor?secret=... — contoh cara buat sama seperti AUTH_SECRET.
CRON_SECRET=
